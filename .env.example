# Sovereign Engine v14.0 - Environment Template
# Copy this to .env and fill in your credentials

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Fyers API v3 Configuration
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_ACCESS_TOKEN=your_access_token_here

# Operational Settings
WEIGHTS_PATH=factor_weights.json
TRADE_LOG_PATH=trade_log.json
PLATT_CALIBRATION_FILE=platt_calibration.json
