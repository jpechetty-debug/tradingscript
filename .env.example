# Sovereign Engine - Environment Template
# Copy this to .env and fill in your credentials

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Fyers API v3 Configuration
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_ACCESS_TOKEN=your_access_token_here
FYERS_REDIRECT_URI=your_redirect_uri_here
# tools/scripts/fyers_setup.py refreshes FYERS_ACCESS_TOKEN in this file.

# Yahoo Finance safeguards (batch price requests, persistent local cache)
YFINANCE_CHUNK_SIZE=50
YFINANCE_MIN_CHUNK_INTERVAL=1.0
YFINANCE_CACHE_TTL_HOURS=24
YFINANCE_NEGATIVE_CACHE_TTL_HOURS=168

# Server API Security
# Required for state-mutating endpoints (/api/scan/trigger, /api/regime/override)
API_KEY=your_secure_api_key_here
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=

# Runtime directories
STATE_DIR=state
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# Optional explicit runtime paths
PORTFOLIO_STATE_PATH=state/portfolio_state.json
WEIGHTS_PATH=state/factor_weights.json
TRADE_LOG_PATH=state/trade_log.json
PLATT_CALIB_PATH=state/platt_calibration.json
TELEMETRY_LOG_PATH=logs/sovereign.jsonl
DEGRADATION_LOG_PATH=logs/data_provider_degradation.log
